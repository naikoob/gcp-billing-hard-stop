# ==============================================================================
# Terraform
# ==============================================================================
# Local .terraform directories and cache
**/.terraform/*
.terraform/

# State files and local state backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable definition files (contain environment-specific values and sensitive data)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Explicitly track template/example variable files
!terraform.tfvars.example
!*.tfvars.example

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Note: .terraform.lock.hcl is intentionally committed to version control
# to ensure consistent provider selection across environments.

# ==============================================================================
# Python (Cloud Function)
# ==============================================================================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local function packaging zips
*.zip

# ==============================================================================
# Credentials & Secrets
# ==============================================================================
# Environment files
.env
.env.*
!.env.example

# GCP service account keys and SSL certificates
*key*.json
*credentials*.json
*.pem
*.key

# ==============================================================================
# Operating System & IDE Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Editors & IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

